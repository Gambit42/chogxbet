# From dashboard.privy.io; wallet login is disabled without it
NEXT_PUBLIC_PRIVY_APP_ID=
# Testnet mock contracts (contracts/src). Mainnet addresses live in src/features/betting/networks.ts
# tCHOG (MockChog) address; the testnet balance shows "—" until set
NEXT_PUBLIC_CHOG_ADDRESS=
# Test Chog Genesis (MockChogNFT) address; faucet NFT mint is disabled until set
NEXT_PUBLIC_CHOG_NFT_ADDRESS=
# Wallet that receives the 5% MON fee (buyback fund); only read by npm run deploy:duel
TREASURY_ADDRESS=
# ChogDuel escrow address (npm run deploy:duel, after the two above are set); duel creation is disabled until set
NEXT_PUBLIC_DUEL_ADDRESS=
# Optional testnet RPC (e.g. free Alchemy key); unset uses the public testnet-rpc.monad.xyz
NEXT_PUBLIC_TESTNET_RPC_URL=
