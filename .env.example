# ═══ FRONTEND: Vercel project env (also .env locally for npm run dev) ═══
# From dashboard.privy.io; wallet login is disabled without it
NEXT_PUBLIC_PRIVY_APP_ID=
# Testnet mock contracts (contracts/src). Mainnet addresses live in src/features/betting/networks.ts
# $CHOG (MockChog) address; the testnet balance shows "—" until set
NEXT_PUBLIC_CHOG_ADDRESS=
# Test Chog Genesis (MockChogNFT) address; faucet NFT mint is disabled until set
NEXT_PUBLIC_CHOG_NFT_ADDRESS=
# ChogDuel escrow address (npm run deploy:duel); duel creation is disabled until set
NEXT_PUBLIC_DUEL_ADDRESS=
# LastWord address (npm run deploy:lastword); Last Word creation is disabled and the Wall shows "Last Word isn't live" until set
NEXT_PUBLIC_LASTWORD_ADDRESS=
# Optional testnet RPC (e.g. free Alchemy key); unset uses the public testnet-rpc.monad.xyz
NEXT_PUBLIC_TESTNET_RPC_URL=

# ═══ BACKEND: Railway settle bot Variables (npm run settle every 10 min) ═══
# Same address as NEXT_PUBLIC_DUEL_ADDRESS (the one ChogDuel contract holding every duel)
DUEL_CONTRACT_ADDRESS=
# Same address as NEXT_PUBLIC_LASTWORD_ADDRESS; unset skips Last Word settlement
LASTWORD_CONTRACT_ADDRESS=
# Fresh wallet (cast wallet new) holding only gas MON. Settling is permissionless, so the key has no other power. Never commit it
SETTLER_PRIVATE_KEY=
# mainnet|testnet, default testnet
NETWORK=testnet
# Optional; unset uses the chain's public RPC
RPC_URL=

# ─── One-time contract deploy: local .env only, never on Vercel or Railway ───
# Wallet that receives the 5% MON fee (buyback fund). npm run deploy:duel also reads the two NEXT_PUBLIC_CHOG_* above
TREASURY_ADDRESS=
# Public address of SETTLER_PRIVATE_KEY; the only wallet allowed to fill the testnet FeedMirrors with mainnet Chainlink rounds
SETTLER_ADDRESS=
# Existing testnet FeedMirrors (MON,BTC,SOL,ETH, comma separated) for npm run deploy:duel to reuse; unset deploys new ones
FEED_MIRRORS=
