{
  "name": "chog-conviction",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy:chog": "forge create contracts/src/testnet/MockChog.sol:MockChog --rpc-url monad_testnet --browser --broadcast",
    "deploy:nft": "forge create contracts/src/testnet/MockChogNFT.sol:MockChogNFT --rpc-url monad_testnet --browser --broadcast",
    "deploy:duel": "forge script contracts/script/DeployDuel.s.sol:DeployDuel --rpc-url monad_testnet --browser --broadcast",
    "deploy:testnet": "npm run deploy:chog && npm run deploy:nft",
    "settle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/settle.mts",
    "settle:local": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/settle.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@privy-io/react-auth": "^3.50.0",
    "@privy-io/wagmi": "^4.0.19",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "nextjs-toploader": "^3.9.17",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "viem": "2.57.5",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
